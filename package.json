{
  "name": "@mega-yfue/eufy-sdk",
  "version": "0.0.5",
  "description": "One typed TypeScript client for the eufy v6 cloud — capability-driven devices, realtime events over P2P/MQTT/push, and live media",
  "license": "Apache-2.0",
  "author": "mega-yfue",
  "contributors": [
    "max246",
    "lenoxys",
    "martijnpoppen"
  ],
  "keywords": [
    "eufy",
    "anker",
    "eufy-security",
    "smart-home",
    "camera",
    "doorbell",
    "vacuum",
    "smart-light",
    "p2p",
    "mqtt",
    "webrtc",
    "typescript",
    "sdk"
  ],
  "homepage": "https://mega-yfue.github.io/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mega-yfue/eufy-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/mega-yfue/eufy-sdk/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p examples/tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "guard:consumer-agnostic": "bash scripts/ci/guard-consumer-agnostic.sh",
    "guard:decorrelation": "bash scripts/ci/guard-decorrelation.sh",
    "guard:docrefs": "bash scripts/ci/guard-doc-refs.sh",
    "guard:lines": "bash scripts/ci/guard-lines.sh",
    "guard:seal": "bash scripts/ci/guard-seal.sh",
    "check:esm": "node -e \"import('./dist/index.js').then(m=>console.log('ESM OK:',Object.keys(m).length,'exports'))\"",
    "verify": "npm run format:check && npm run typecheck && npm run guard:decorrelation && npm run guard:lines && npm run guard:docrefs && npm run guard:consumer-agnostic && npm run build && npm run guard:seal && npm run check:esm && npm run typecheck:examples && npm test",
    "release": "bash scripts/release.sh"
  },
  "engines": {
    "node": ">=24.5.0"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "mqtt": "^5.15.2",
    "protobufjs": "^8.7.2",
    "werift": "^0.24.4"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "unrs-resolver@1.12.2": true
  }
}
